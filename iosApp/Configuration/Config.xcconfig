// App identity and versioning, shared by Debug and Release. scripts/rename.sh rewrites these values.

// Your Apple Developer Team ID (developer.apple.com > Membership). Needed to run on a device / ship.
TEAM_ID =

// Name under the icon on the home screen (may contain spaces).
APP_DISPLAY_NAME = Template
// Technical name (no spaces): .app bundle and Swift module name.
PRODUCT_NAME = Template
PRODUCT_BUNDLE_IDENTIFIER = com.example.template

// Version shown to users. Bumped automatically by release-please from conventional commits.
MARKETING_VERSION = 0.1.0 // x-release-please-version
// Build number for local builds. The TestFlight lane sets it to the latest TestFlight build + 1.
CURRENT_PROJECT_VERSION = 1
